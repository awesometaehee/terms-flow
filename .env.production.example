# 운영 서버용. .env.production으로 복사해 값을 바꾼다. 실제 비밀번호·키는 커밋하지 않는다.
# 실행: docker compose --env-file .env.production up -d --build

# PostgreSQL (compose의 db 컨테이너)
POSTGRES_DB=terms_flow
POSTGRES_USER=terms_flow
POSTGRES_PASSWORD=change-me

# S3 호환 파일 저장소 (compose의 storage 컨테이너)
S3_ACCESS_KEY=terms-flow
S3_SECRET_KEY=change-me-too
S3_BUCKET=terms-flow-documents

# 화면 접속 포트 (서버)
WEB_PORT=8080

# PNG 해상도
RENDER_PNG_DPI=150
