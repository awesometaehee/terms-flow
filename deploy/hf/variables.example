# Hugging Face Space → Settings → Variables and secrets 에 넣을 값 (예시). 실제 값은 이 파일·저장소에 쓰지 않는다.
# 비밀 값(Secret)과 일반 값(Variable)을 구분해 넣는다.

# --- Secret ---------------------------------------------------------------------------------
# Supabase → Connect → Session pooler (포트 5432) 주소. 끝에 ?sslmode=require 를 붙인다.
# (Direct connection은 IPv6 전용이라 Space에서 연결되지 않을 수 있다. Transaction pooler(6543)는 쓰지 않는다)
DATABASE_URL=postgresql://postgres.<프로젝트ID>:<DB 비밀번호>@aws-0-<지역>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase → Storage → S3 Connection → New access key 로 만든 키
S3_ACCESS_KEY=<access key id>
S3_SECRET_KEY=<secret access key>

# 검토용 계정 (HTTP Basic). "아이디:비밀번호" 를 쉼표로 이어 쓴다. DEPLOY.md의 "테스트 계정"으로 만든다.
BASIC_AUTH_USERS=reviewer1:<비밀번호>,reviewer2:<비밀번호>

# --- Variable -------------------------------------------------------------------------------
# Supabase → Storage → S3 Connection 의 Endpoint, Region
S3_ENDPOINT_URL=https://<프로젝트ID>.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-2
# Supabase Storage에 미리 만든 비공개(Private) 버킷 이름
S3_BUCKET=kms-review

# (선택) 접속 허용 IP·대역. 비우면 계정만 확인한다.
# ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# 가상 데이터: DB가 비어 있을 때 한 번 넣는다. 넣지 않으려면 false
SEED_DEMO_DATA=true
RENDER_PNG_DPI=150
