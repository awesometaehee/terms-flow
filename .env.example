# 로컬 개발용. .env로 복사해 값을 바꾼다. 실제 비밀번호는 .env에만 쓰고 커밋하지 않는다.
# (운영 배포 설정은 .env.production.example)

# PostgreSQL — PC에 설치한 로컬 PostgreSQL
# 앱 사용자에게 CREATEDB 권한이 있어야 테스트 DB({POSTGRES_DB}_test)를 자동으로 만든다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=terms_flow
POSTGRES_USER=terms_flow
POSTGRES_PASSWORD=change-me

# 파일 저장소 — 로컬 개발은 저장소 루트의 data/storage 폴더 (기본값)
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=C:/path/to/storage

# PNG 해상도
RENDER_PNG_DPI=150
